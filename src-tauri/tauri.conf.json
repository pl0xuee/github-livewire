{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "livewire",
  "version": "0.3.3",
  "identifier": "dev.pl0xuee.livewire",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "mkdir -p src-tauri/dist && cp index.html style.css app.js src-tauri/dist/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "livewire — github telemetry",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
